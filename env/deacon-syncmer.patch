+/// K-mer selection scheme. Stored in the index header; reads are always
+/// sketched with the scheme of the index they are compared against.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default, serde::Serialize, serde::Deserialize)]
+#[cfg_attr(feature = "cli", derive(clap::ValueEnum))]
+#[serde(rename_all = "lowercase")]
+pub enum Scheme {
+    /// Random minimizers: keys are k-mers (k = kmer_length), one per window of
+    /// w consecutive k-mers (w = window_size). Density ≈ 2/(w+1).
+    #[default]
+    Minimizer,
+    /// Closed syncmers: keys are l-mers (l = kmer_length) whose smallest s-mer
+    /// (s = window_size) sits at either end. Selection is context-free, so a
+    /// mutation next to a key cannot change whether it is selected.
+    /// Density ≈ 2/(l−s+1); l ≤ 32 and odd.
+    Syncmer,
+}
+
+impl Scheme {
+    pub fn from_u8(v: u8) -> Option<Self> {
+        match v {
+            0 => Some(Self::Minimizer),
+            1 => Some(Self::Syncmer),
+            _ => None,
+        }
+    }
+    pub fn as_u8(self) -> u8 {
+        match self {
+            Self::Minimizer => 0,
+            Self::Syncmer => 1,
+        }
+    }
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Minimizer => "minimizer",
+            Self::Syncmer => "syncmer",
+        }
+    }
+    /// (k, w) in simd-minimizers' own notation. For syncmers the crate's k is
+    /// the s-mer and its window l = w + k − 1 is our key, so w = l − s + 1.
+    pub fn crate_params(self, kmer_length: u8, window_size: u8) -> (usize, usize) {
+        match self {
+            Self::Minimizer => (kmer_length as usize, window_size as usize),
+            Self::Syncmer => (
+                window_size as usize,
+                kmer_length as usize - window_size as usize + 1,
+            ),
+        }
+    }
+    /// Length of the unit the hasher hashes: k for minimizers, s for syncmers.
+    pub fn hash_len(self, kmer_length: u8, window_size: u8) -> usize {
+        self.crate_params(kmer_length, window_size).0
+    }
+}
